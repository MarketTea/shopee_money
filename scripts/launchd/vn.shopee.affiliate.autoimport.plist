        <key>PATH</key>
        <string>/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:/Users/sotatek/.nvm/versions/node/v20.20.2/bin</string>
        <key>HOME</key>
        <string>/Users/sotatek</string>
        <key>SESSION_DIR</key>
        <string>/Users/sotatek/Downloads/shopee_money/scripts/.session</string>
    </dict>

    <!-- Khởi động lại nếu crash -->
    <key>KeepAlive</key>
