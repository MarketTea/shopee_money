<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>vn.shopee.affiliate.autoimport</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/sotatek/.nvm/versions/node/v20.20.2/bin/node</string>
        <string>/Users/sotatek/Downloads/shopee_money/scripts/auto-import.mjs</string>
    </array>

    <!-- Chạy mỗi ngày lúc 12:00 trưa -->
    <key>StartCalendarInterval</key>
